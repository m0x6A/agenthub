# Local Development Environment Variables
# Copy this file to .env.local and customize as needed

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=agentbus-local
COMPOSE_FILE=docker-compose.yml

# Cosmos DB Emulator
COSMOS_DB_PORT=8081
COSMOS_DB_MASTER_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyZLgiCvqqPH+1DQtQ==
COSMOS_DB_DATABASE_NAME=agentbus
COSMOS_DB_AGENTS_CONTAINER=agents
COSMOS_DB_SUBSCRIPTIONS_CONTAINER=subscriptions

# Service Bus Emulator
SERVICE_BUS_PORT=5672
SERVICE_BUS_HTTP_PORT=9600
SERVICE_BUS_NAMESPACE=localhost

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# Logging
LOG_LEVEL=Debug

# Security (Local Only - Not for Production)
JWT_AUDIENCE=api://local-agentbus
JWT_TENANT_ID=00000000-0000-0000-0000-000000000000
JWT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Application Insights (Optional - will use mock in local)
APPINSIGHTS_INSTRUMENTATION_KEY=00000000-0000-0000-0000-000000000000
