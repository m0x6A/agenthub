  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.1.1" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBus.Broker\AgentBus.Broker.csproj" />
    <ProjectReference Include="..\..\examples\AgentBus.Examples.CustomerExperience\AgentBus.Examples.CustomerExperience.csproj" />
    <ProjectReference Include="..\..\examples\AgentBus.Examples.OperationsInventory\AgentBus.Examples.OperationsInventory.csproj" />
    <ProjectReference Include="..\..\examples\AgentBus.Examples.FinancialAuth\AgentBus.Examples.FinancialAuth.csproj" />
    <ProjectReference Include="..\..\examples\AgentBus.Examples.InternalComms\AgentBus.Examples.InternalComms.csproj" />
  </ItemGroup>

</Project>
